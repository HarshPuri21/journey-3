        {
          "type": "heading",
          "level": 3,
          "text": "{別|べつ}の{場所|ばしょ}"
        },
        {
          "type": "text",
          "text": "**べつの ばしょ**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "another/different place"
        },
        {
          "type": "text",
          "text": "This introduces another useful grammar pattern:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{別|べつ}の + noun"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "another/different ___"
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Connected knowledge"
        },
        {
          "type": "vocabRef",
          "id": "vocab_場所"
        },
        {
          "type": "grammarRef",
          "id": "grammar_betsu_no"
        }
      ]
    },
    {
      "id": "card_04",
      "title": "Past Tense",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "text",
          "text": "You already know:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{行きます|いきます}"
        },
        {
          "type": "text",
          "text": "**いきます**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "go / will go"
        },
        {
          "type": "text",
          "text": "Past:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{行きました|いきました}"
        },
        {
          "type": "text",
          "text": "**いきました**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "went"
        },
        {
          "type": "text",
          "text": "Negative:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{行きません|いきません}"
        },
        {
          "type": "text",
          "text": "**いきません**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "do not go / will not go"
        },
        {
          "type": "text",
          "text": "Past negative:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{行きませんでした|いきませんでした}"
        },
        {
          "type": "text",
          "text": "**いきませんでした**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "did not go"
        },
        {
          "type": "text",
          "text": "This four-part pattern will become extremely important."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Connected knowledge"
        },
        {
          "type": "grammarRef",
          "id": "grammar_polite_past"
        },
        {
          "type": "grammarRef",
          "id": "grammar_polite_past_negative"
        }
      ]
    },
    {
      "id": "card_05",
      "title": "The Four Basic Forms",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "heading",
          "level": 3,
          "text": "{行きます|いきます}"
        },
        {
          "type": "text",
          "text": "go / will go"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{行きません|いきません}"
        },
        {
          "type": "text",
          "text": "do not go / will not go"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{行きました|いきました}"
        },
        {
          "type": "text",
          "text": "went"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{行きませんでした|いきませんでした}"
        },
        {
          "type": "text",
          "text": "did not go"
        },
        {
          "type": "text",
          "text": "We will use this pattern with many verbs."
        }
      ]
    },
