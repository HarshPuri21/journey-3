            "components"
          ]
        }
      ]
    },
    {
      "id": "card_05",
      "title": "Important Number Changes",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "text",
          "text": "Some number combinations change pronunciation."
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{三百|さんびゃく}"
        },
        {
          "type": "text",
          "text": "**さんびゃく**"
        },
        {
          "type": "text",
          "text": "300"
        },
        {
          "type": "text",
          "text": "not *san-hyaku*"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{六百|ろっぴゃく}"
        },
        {
          "type": "text",
          "text": "**ろっぴゃく**"
        },
        {
          "type": "text",
          "text": "600"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{八百|はっぴゃく}"
        },
        {
          "type": "text",
          "text": "**はっぴゃく**"
        },
        {
          "type": "text",
          "text": "800"
        },
        {
          "type": "text",
          "text": "And:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{三千|さんぜん}"
        },
        {
          "type": "text",
          "text": "**さんぜん**"
        },
        {
          "type": "text",
          "text": "3,000"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{八千|はっせん}"
        },
        {
          "type": "text",
          "text": "**はっせん**"
        },
        {
          "type": "text",
          "text": "8,000"
        },
        {
          "type": "text",
          "text": "These changes are called sound changes."
        },
        {
          "type": "text",
          "text": "Don't try to invent the pronunciation."
        },
        {
          "type": "text",
          "text": "Learn these common forms as units."
        }
      ]
    },
    {
      "id": "card_06",
      "title": "Shopping",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "heading",
          "level": 3,
          "text": "これはいくらですか。"
        },
        {
          "type": "text",
          "text": "**これは いくらですか。**"
        },
        {
          "type": "text",
          "text": "**Kore wa ikura desu ka?**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "How much is this?"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{百円|ひゃくえん}です。"
        },
        {
          "type": "text",
          "text": "**ひゃくえんです。**"
        },
        {
          "type": "text",
          "text": "**Hyaku-en desu.**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "It's 100 yen."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Connected knowledge"
        },
        {
          "type": "sentenceRef",
          "id": "sent_hokkaido_chitose_price_question"
