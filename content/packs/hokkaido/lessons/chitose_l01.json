        }
      ]
    },
    {
      "id": "card_07",
      "title": "The Question Particle か",
      "kind": "practice",
      "scroll": true,
      "blocks": [
        {
          "type": "text",
          "text": "You already know:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "これは{百円|ひゃくえん}です。"
        },
        {
          "type": "text",
          "text": "This is 100 yen."
        },
        {
          "type": "text",
          "text": "Add:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "か"
        },
        {
          "type": "text",
          "text": "and it becomes:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "これは{百円|ひゃくえん}ですか。"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "Is this 100 yen?"
        },
        {
          "type": "text",
          "text": "Japanese uses **か** to mark a basic question."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Connected knowledge"
        },
        {
          "type": "grammarRef",
          "id": "grammar_particle_ka"
        }
      ]
    },
    {
      "id": "card_08",
      "title": "Chitose Example",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "heading",
          "level": 3,
          "text": "{千歳|ちとせ}は{北海道|ほっかいどう}の{町|まち}です。"
        },
        {
          "type": "text",
          "text": "**ちとせは ほっかいどうの まちです。**"
        },
        {
          "type": "text",
          "text": "**Chitose wa Hokkaidō no machi desu.**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "Chitose is a city in Hokkaido."
        },
        {
          "type": "text",
          "text": "Now:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{千|せん}"
        },
        {
          "type": "text",
          "text": "thousand"
        },
        {
          "type": "text",
          "text": "is no longer just a number."
        },
        {
          "type": "text",
          "text": "You will start seeing it inside real Japanese words."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Connected knowledge"
        },
        {
          "type": "sentenceRef",
          "id": "sent_hokkaido_chitose_location"
        }
      ]
    },
    {
      "id": "card_09",
      "title": "Mini Question",
      "kind": "practice",
      "scroll": true,
      "blocks": [
        {
          "type": "text",
          "text": "Which means **10,000 yen**?"
        },
        {
          "type": "text",
          "text": "A. {千円|せんえん}\nB. {百円|ひゃくえん}\nC. {一万円|いちまんえん}\nD. {十円|じゅうえん}"
        },
        {
          "type": "text",
          "text": "Answer:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "C — {一万円|いちまんえん}"
        }
      ]
    },
