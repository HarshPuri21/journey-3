  "cards": [
    {
      "id": "arrival",
      "title": "Chitose",
      "kind": "intro",
      "scroll": true,
      "blocks": [
        {
          "type": "heading",
          "level": 1,
          "text": "{千歳|ちとせ}"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "ちとせ"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Chitose"
        },
        {
          "type": "text",
          "text": "Chitose is important to our Journey because it is closely associated with New Chitose Airport, one of the main gateways to Hokkaido."
        },
        {
          "type": "text",
          "text": "Look at the name:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{千|せん}"
        },
        {
          "type": "text",
          "text": "**せん**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "thousand"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "歳"
        },
        {
          "type": "text",
          "text": "**さい / とし**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "age / years"
        },
        {
          "type": "text",
          "text": "But the place name is:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{千歳|ちとせ}"
        },
        {
          "type": "text",
          "text": "**ちとせ**"
        },
        {
          "type": "text",
          "text": "This is another reminder:"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "Place names sometimes have readings that must simply be learned."
        }
      ]
    },
    {
      "id": "inside_chitose",
      "title": "Inside 千歳",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "text",
          "text": "Look inside the name of {千歳|ちとせ}. Each kanji can be broken into parts - and parts are clues."
        },
        {
          "type": "kanjiRef",
          "id": "kanji_千",
          "show": [
            "meaning",
            "readings",
            "components"
          ]
        },
        {
          "type": "kanjiRef",
          "id": "kanji_歳",
          "show": [
            "meaning",
            "readings",
            "components"
          ]
        },
        {
          "type": "radicalRef",
          "id": "radical_juu"
        },
        {
          "type": "radicalRef",
          "id": "radical_tome"
        },
        {
          "type": "callout",
          "text": "千 is filed under 十 (ten). 歳 is filed under 止 (stop), which gives no hint of 'age'. Another reminder: not every radical is a meaning clue. Components are clues, not magic definitions.",
          "tone": "tip"
        }
      ]
    },
    {
      "id": "card_02",
      "title": "千",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "heading",
          "level": 1,
          "text": "{千|せん}"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "せん"
        },
        {
          "type": "text",
          "text": "**sen**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "thousand"
        },
        {
          "type": "text",
          "text": "You already know:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{十|じゅう}"
        },
        {
          "type": "text",
          "text": "10"
        },
        {
          "type": "text",
          "text": "Now:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{百|ひゃく}"
        },
        {
          "type": "text",
          "text": "**ひゃく**"
        },
        {
          "type": "text",
          "text": "100"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{千|せん}"
        },
        {
          "type": "text",
          "text": "**せん**"
        },
        {
          "type": "text",
          "text": "1,000"
        },
        {
          "type": "text",
          "text": "This gives us an important progression:"
        },
        {
          "type": "text",
          "text": "**{十|じゅう} → {百|ひゃく} → {千|せん}**"
        },
        {
          "type": "text",
          "text": "10 → 100 → 1,000"
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Connected knowledge"
        },
        {
          "type": "kanjiRef",
          "id": "kanji_百",
          "show": [
            "meaning",
            "readings",
            "components"
          ]
        },
        {
          "type": "kanjiRef",
          "id": "kanji_千",
          "show": [
            "meaning",
            "readings",
            "components"
          ]
        }
      ]
    },
    {
      "id": "card_03",
      "title": "万",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "text",
          "text": "Now we reach a very important Japanese number concept."
        },
        {
          "type": "heading",
          "level": 1,
          "text": "{万|まん}"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "まん"
        },
        {
          "type": "text",
          "text": "**man**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "ten thousand"
        },
        {
          "type": "text",
          "text": "Japanese groups large numbers around **10,000**, rather than 1,000 as English commonly does."
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{一万|いちまん}"
        },
        {
          "type": "text",
          "text": "**いちまん**"
        },
        {
          "type": "text",
          "text": "10,000"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{二万|にまん}"
        },
        {
          "type": "text",
          "text": "**にまん**"
        },
        {
          "type": "text",
          "text": "20,000"
        },
        {
          "type": "text",
          "text": "This is extremely important when reading Japanese prices."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Connected knowledge"
        },
        {
          "type": "kanjiRef",
          "id": "kanji_万",
          "show": [
            "meaning",
            "readings",
            "components"
          ]
        }
      ]
    },
    {
      "id": "card_04",
      "title": "円",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "heading",
          "level": 1,
          "text": "{円|えん}"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "えん"
        },
        {
          "type": "text",
          "text": "**en**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "yen"
        },
        {
          "type": "text",
          "text": "This is the currency of Japan."
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{百円|ひゃくえん}"
        },
        {
          "type": "text",
          "text": "**ひゃくえん**"
        },
        {
          "type": "text",
          "text": "100 yen"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{千円|せんえん}"
        },
        {
          "type": "text",
          "text": "**せんえん**"
        },
        {
          "type": "text",
          "text": "1,000 yen"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{一万円|いちまんえん}"
        },
        {
          "type": "text",
          "text": "**いちまんえん**"
        },
        {
          "type": "text",
          "text": "10,000 yen"
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Connected knowledge"
        },
        {
          "type": "kanjiRef",
          "id": "kanji_円",
          "show": [
            "meaning",
