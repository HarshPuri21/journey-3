        {
          "type": "heading",
          "level": 3,
          "text": "路"
        },
        {
          "type": "text",
          "text": "**みち / ろ**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "road / route"
        },
        {
          "type": "text",
          "text": "Together:"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "{釧路|くしろ}"
        },
        {
          "type": "text",
          "text": "**くしろ**"
        },
        {
          "type": "callout",
          "tone": "quote",
          "text": "Kushiro"
        }
      ]
    },
    {
      "id": "inside_kushiro",
      "title": "Inside 釧路",
      "kind": "content",
      "scroll": true,
      "blocks": [
        {
          "type": "text",
          "text": "Look inside the name of {釧路|くしろ}. Each kanji can be broken into parts - and parts are clues."
        },
        {
          "type": "kanjiRef",
          "id": "kanji_釧",
          "show": [
            "meaning",
            "readings",
            "components"
          ]
        },
        {
          "type": "kanjiRef",
          "id": "kanji_路",
          "show": [
            "meaning",
            "readings",
            "components"
          ]
        },
        {
          "type": "radicalRef",
          "id": "radical_kane"
        },
        {
          "type": "radicalRef",
          "id": "radical_kawa"
        },
        {
          "type": "radicalRef",
          "id": "radical_ashi"
        },
        {
          "type": "callout",
          "text": "釧 combines 金 (metal) and 川 (river): 金 is the meaning clue, 川 hints at the sound セン. 路 carries 足 (foot). 道 and 路 both mean road, but with different clues: 辶 and 足. Components are clues, not magic definitions.",
          "tone": "tip"
        }
      ]
    },
