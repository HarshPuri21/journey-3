          "text": "旭 — rising sun\n{川|かわ} — river"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Months"
        },
        {
          "type": "text",
          "text": "{一月|いちがつ} through {十二月|じゅうにがつ}"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Important date readings"
        },
