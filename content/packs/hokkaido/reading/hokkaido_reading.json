    {
      "id": "foundation_core_particles",
      "title": "Core Particles",
      "kind": "review",
      "scroll": true,
      "blocks": [
        {
          "type": "heading",
          "level": 3,
          "text": "は"
        },
        {
          "type": "text",
          "text": "topic"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "が"
        },
        {
          "type": "text",
          "text": "subject / existence"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "を"
        },
        {
          "type": "text",
          "text": "object"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "に"
        },
        {
          "type": "text",
          "text": "destination / point in time / location"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "で"
        },
        {
          "type": "text",
          "text": "place where an action occurs"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "の"
        },
        {
          "type": "text",
          "text": "relationship / possession"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "も"
        },
        {
          "type": "text",
          "text": "also / too"
        },
        {
          "type": "text",
          "text": "These are not all the possible uses of these particles."
        },
        {
          "type": "text",
          "text": "They are the **first useful meanings** the learner needs."
        },
        {
          "type": "grammarRef",
          "id": "grammar_particle_mo"
        }
