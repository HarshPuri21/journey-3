    {
      "id": "foundation_core_verbs",
      "title": "Core Verbs",
      "kind": "review",
      "scroll": true,
      "blocks": [
        {
          "type": "text",
          "text": "{行く|いく} — いく — go\n{見る|みる} — みる — see/watch\n{飲む|のむ} — のむ — drink\nあります — exists / there is\nいます — exists / there is\n{登る|のぼる} — のぼる — climb"
        },
        {
          "type": "text",
          "text": "Basic polite forms:"
        },
        {
          "type": "text",
          "text": "{行きます|いきます} — go\n{行きません|いきません} — don't/won't go\n{行きました|いきました} — went\n{行きませんでした|いきませんでした} — didn't go"
        }
      ]
    },
    {
      "id": "foundation_core_sentence_patterns",
      "title": "Core Sentence Patterns",
      "kind": "review",
      "scroll": true,
      "blocks": [
        {
          "type": "heading",
          "level": 3,
          "text": "A は B です。"
        },
        {
          "type": "text",
          "text": "A is B."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "A は B ですか。"
        },
        {
          "type": "text",
          "text": "Is A B?"
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "N1 の N2"
        },
        {
          "type": "text",
          "text": "N2 of N1 / N2 associated with N1"
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "N に {行きます|いきます}。"
        },
        {
          "type": "text",
          "text": "Go to N."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "N で Vます。"
        },
        {
          "type": "text",
          "text": "Do V at N."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "N を Vます。"
        },
        {
          "type": "text",
          "text": "Do V to/on N."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "N が あります。"
        },
        {
          "type": "text",
          "text": "There is N."
        },
        {
          "type": "text",
          "text": "For things."
        },
        {
          "type": "divider"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "N が います。"
        },
        {
          "type": "text",
          "text": "There is N."
        },
        {
          "type": "text",
          "text": "For people/animals."
        }
      ]
    },
